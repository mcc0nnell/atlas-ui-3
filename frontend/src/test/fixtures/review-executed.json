   "source": [
    "# Chesapeake sample analysis\n",
    "Aggregate three synthetic observations with TalkPipe and Python."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "pipeline",
   "metadata": {},
   "outputs": [],
   "source": [
    "from talkpipe.chatterlang import compiler\n",
    "normalize = compiler.compile('| toDict[field_list=\"_:value\"]').as_function(single_in=True, single_out=True)\n",
    "records = [normalize(x) for x in [10,20,30]]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "result",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "TalkPipe total: 60\n"
     ]
    }
   ],
   "source": [
    "total = sum(record['value'] for record in records)\n",
    "assert total == 60\n",
    "print(f'TalkPipe total: {total}')"
   ]
  }
 ],
